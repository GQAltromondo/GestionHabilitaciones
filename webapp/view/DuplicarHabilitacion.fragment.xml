<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout">

    <Dialog
        id="dlgDuplicar"
        title="Duplicar Habilitación"
        contentWidth="600px"
        draggable="true"
        resizable="true">

        <content>
            <f:Form editable="false">
                <f:layout>
                    <f:ResponsiveGridLayout
                        labelSpanL="4" labelSpanM="4" labelSpanS="12"
                        emptySpanL="0" emptySpanM="0"
                        columnsL="2" columnsM="2"/>
                </f:layout>
                <f:formContainers>
                    <f:FormContainer title="Datos del Titular">
                        <f:formElements>
                            <f:FormElement label="{i18n>Empresa}">
                                <f:fields><Text text="{DuplicarModel>/Empresa}"/></f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>Legajo}">
                                <f:fields><Text text="{DuplicarModel>/Legajo}"/></f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>Nombre}">
                                <f:fields><Text text="{DuplicarModel>/Nombre}"/></f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>Apellido}">
                                <f:fields><Text text="{DuplicarModel>/Apellido}"/></f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>Documento}">
                                <f:fields><Text text="{DuplicarModel>/Documento}"/></f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>Base}">
                                <f:fields><Text text="{DuplicarModel>/Base}"/></f:fields>
                            </f:FormElement>
                        </f:formElements>
                    </f:FormContainer>
                    <f:FormContainer title="Datos de la Habilitación">
                        <f:formElements>
                            <f:FormElement label="{i18n>Tipo}">
                                <f:fields><Text text="{DuplicarModel>/Clasehab}"/></f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>func}">
                                <f:fields><Text text="{DuplicarModel>/Tipohab}"/></f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>textRegion}">
                                <f:fields><Text text="{DuplicarModel>/Area}"/></f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>VtoDeHab}">
                                <f:fields><Text text="{DuplicarModel>/Vigencia}"/></f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>VtoApto}">
                                <f:fields><Text text="{DuplicarModel>/VtoApto}"/></f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>Idhabilitacion}">
                                <f:fields><Text text="{DuplicarModel>/Idhabilitacion}"/></f:fields>
                            </f:FormElement>
                        </f:formElements>
                    </f:FormContainer>
                </f:formContainers>
            </f:Form>
        </content>

        <beginButton>
            <Button
                text="Confirmar Duplicado"
                type="Emphasized"
                press=".onConfirmarDuplicar"/>
        </beginButton>
        <endButton>
            <Button
                text="Cancelar"
                press=".onCancelarDuplicar"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>
